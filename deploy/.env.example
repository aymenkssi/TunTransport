# --- Choix de la pile ---
# Serveur qui a déjà Traefik devant d'autres applications : décommentez la ligne suivante.
# COMPOSE_FILE=docker-compose.traefik.yml

# Domaines pointant vers l'IP du VPS (enregistrements DNS A pour api, @ et www)
DOMAIN=api.tuntransport.academy
SITE_DOMAIN=tuntransport.academy

# Identifiants MongoDB (choisir un mot de passe long, ex. `openssl rand -hex 24`)
MONGO_USER=tuntransport
MONGO_PASSWORD=change-me

# Jeton de la page d'administration https://api.tuntransport.academy/admin
# (au moins 16 caractères, ex. `openssl rand -hex 32`). Vide = administration désactivée.
ADMIN_TOKEN=

# --- Traefik existant (uniquement avec docker-compose.traefik.yml) ---
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
