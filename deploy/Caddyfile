# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically (Let's Encrypt).
{$DOMAIN} {
	encode gzip
	reverse_proxy api:8001
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 64KB
	}
}

# Website: home page, app-ads.txt (required by AdMob) and the privacy policy (required by Google Play).
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode gzip
	root * /srv/site
	try_files {path} {path}.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
}
