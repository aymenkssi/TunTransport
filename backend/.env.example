# Copier ce fichier en `.env` pour lancer l'API en local (hors Docker).
MONGO_URL=mongodb://localhost:27017
DB_NAME=tuntransport

# Réseau généré par `python3 tools/import_tunismapper.py --out backend/data/network.json`
# NETWORK_FILE=data/network.json
# Adresses du Grand Tunis générées par `python3 tools/import_places.py --out backend/data/places.json`
# PLACES_FILE=data/places.json

# Jeton de la page http://localhost:8001/admin (16 caractères minimum)
ADMIN_TOKEN=dev-admin-token-change-me
