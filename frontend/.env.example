# Copier ce fichier en `.env` puis adapter la valeur.
# Sur un téléphone/émulateur, "localhost" ne pointe PAS vers votre PC :
#  - Émulateur Android : http://10.0.2.2:8001
#  - Téléphone physique (même Wi-Fi) : http://<IP-locale-du-PC>:8001
#  - Navigateur (yarn web) : http://localhost:8001
#  - Serveur de production : https://api.tuntransport.academy (voir deploy/README.md)
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8001

# Site web (politique de confidentialité), ex. https://tuntransport.academy. Facultatif.
EXPO_PUBLIC_SITE_URL=

# "test" (défaut) = publicités de test Google ; "production" = vraies unités TransTunisLive
# (renseignées dans src/ads/index.ts, activées automatiquement par le profil EAS "production").
# Ne jamais utiliser "production" sur votre propre téléphone : cliquer ses propres pubs peut faire suspendre le compte AdMob.
EXPO_PUBLIC_AD_MODE=test
